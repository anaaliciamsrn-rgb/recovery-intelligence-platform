# Copie para .env e ajuste os valores para o seu ambiente local.
# Nenhum segredo real deve ser commitado — este arquivo só documenta as chaves.

NODE_ENV=development
PORT=3000

# Aponta para o serviço "postgres" do docker-compose.yml (raiz do repo).
DATABASE_URL=postgresql://rip:rip@localhost:5432/recovery_intelligence

# Aponta para o serviço "redis" do docker-compose.yml (raiz do repo).
REDIS_URL=redis://localhost:6379

# Lista separada por vírgulas. Vazio = nenhuma origem cross-site é permitida.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Propriedade do artefato de build, não do ambiente — em dev local não existe
# build, então fica "unknown". Em produção vem de `ARG BUILD_TIMESTAMP` do
# Dockerfile (ver docker-compose.yml e apps/api/Dockerfile).
BUILD_TIMESTAMP=unknown

# --- Identidade e Controle de Acesso ---
# Gere um valor forte, ex.: `openssl rand -base64 48`. Sem default de propósito.
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-de-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Parâmetros do Argon2id (ver docs/architecture/decisions/0010).
ARGON2_MEMORY_COST_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate limit específico da rota de login (mais estrito que o genérico).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# Bloqueio de conta após falhas consecutivas (independente do rate limit acima).
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_DURATION_SECONDS=900

REFRESH_TOKEN_COOKIE_NAME=rip_refresh_token

# Origem pública do frontend — usada em links de e-mail (redefinição de
# senha) e como destino de redirect pós-OAuth.
APP_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# --- E-mail (ver docs/RELATORIO_AUTH_E_UX.md) ---
# Sem SMTP_HOST, o container usa o ConsoleEmailProvider (imprime o link de
# redefinição de senha no log — útil para demonstração local sem SMTP real).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Recovery Intelligence Platform <no-reply@exemplo.com>

# --- OAuth / Login social (ver docs/RELATORIO_AUTH_E_UX.md) ---
# Cada provedor só fica ativo (botão real no frontend, rotas funcionais)
# quando client id + secret + redirect uri estão todos presentes. Sem isso,
# GET /auth/oauth/providers reporta `false` e o frontend mostra "em breve".
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/microsoft/callback
# MICROSOFT_OAUTH_TENANT_ID=common

# --- Só para `pnpm prisma:seed` (script avulso, não faz parte do schema do
# servidor acima — ver prisma/seed.ts) ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte-de-12-chars
