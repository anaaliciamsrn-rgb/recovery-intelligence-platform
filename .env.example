# Variáveis usadas pelo docker-compose.yml para provisionar os serviços de apoio (Postgres/Redis).
# Cada app (apps/api) tem seu próprio .env.example com as variáveis que consome em runtime.

POSTGRES_USER=rip
POSTGRES_PASSWORD=rip
POSTGRES_DB=recovery_intelligence
POSTGRES_PORT=5432

REDIS_PORT=6379

# Sobrescreve o default inseguro do docker-compose.yml para o serviço "api".
# Gere um valor real: `openssl rand -base64 48`.
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-de-32-chars
